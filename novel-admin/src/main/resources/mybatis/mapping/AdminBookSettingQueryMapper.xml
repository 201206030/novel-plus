<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.java2nb.novel.mapper.AdminBookSettingQueryMapper">

    <select id="listAll" resultType="com.java2nb.novel.vo.AdminBookSettingVO">
        select t1.*, t2.book_name, t2.author_name
        from book_setting t1
        left join book t2 on t1.book_id = t2.id
        <where>
            <if test="type != null">
                and t1.type = #{type}
            </if>
        </where>
        order by t1.type, t1.sort, t1.create_time desc
    </select>

</mapper>
